{
	"name": "edu-api",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy --env production-ben",
		"deploy:production-ben": "wrangler deploy --env production-ben",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply edu-api --local",
		"db:migrate:remote": "wrangler d1 migrations apply edu-api --remote",
		"db:migrate:remote:production-ben": "wrangler d1 migrations apply edu-api --remote --env production-ben",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@edu/chat-contract": "link:../../packages/chat-contract",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/context-async-hooks": "^2.11.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.6.18",
		"drizzle-orm": "1.0.0-beta.22",
		"katex": "^0.18.5",
		"nanoid": "^6.0.1",
		"openai": "^5.12.2",
		"zod": "^3.24.2",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@types/katex": "^0.16.8",
		"@types/node": "^26.2.0",
		"drizzle-kit": "1.0.0-beta.23",
		"typescript": "^5.5.2",
		"vitest": "^3.0.9",
		"wrangler": "^4.129.0"
	}
}
