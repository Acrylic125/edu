/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edu-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["ChatDurableObject"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ChatDurableObject",
				"name": "CHAT_DURABLE_OBJECT"
			}
		]
	},
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:8787"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edu-api",
			"database_id": "16cc2e87-d2b9-4a65-bf36-c236864c91e6",
			"migrations_dir": "migrations",
			"migrations_pattern": "migrations/*/migration.sql"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"env": {
		"production": {
			"routes": [
				{
					"pattern": "edu-api.benapps.dev",
					"custom_domain": true
				}
			],
			"vars": {
				"BETTER_AUTH_URL": "https://edu-api.benapps.dev"
			},
			"migrations": [
				{
					"new_sqlite_classes": ["ChatDurableObject"],
					"tag": "v1"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "ChatDurableObject",
						"name": "CHAT_DURABLE_OBJECT"
					}
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "edu-api",
					"database_id": "16cc2e87-d2b9-4a65-bf36-c236864c91e6",
					"migrations_dir": "migrations",
					"migrations_pattern": "migrations/*/migration.sql"
				}
			]
		}
	}
}
