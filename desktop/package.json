{
  "name": "edu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EdU desktop tutoring workspace",
  "author": "EdU",
  "main": "out/main/index.js",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "test:rendering": "electron-vite build --config electron.rendering.config.ts && node scripts/test-rendering.mjs",
    "test:electron": "electron-vite build --config electron.test.config.ts && node scripts/test-electron.mjs",
    "test:packaged": "electron-vite build --config electron.test.config.ts && node scripts/test-packaged.mjs",
    "postinstall": "pnpm exec install-electron",
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/create-icon.mjs && pnpm typecheck && electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && electron-builder && pnpm test:packaged",
    "package:dir": "pnpm build && electron-builder --dir -c.mac.identity=null && pnpm test:packaged"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "2.14.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "^1.0.11",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@tesseract.js-data/eng": "1.0.0",
    "cheerio": "1.2.0",
    "electron-updater": "^6.8.11",
    "officeparser": "8.1.1",
    "openai": "^7.32.0",
    "tesseract.js": "7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@edu/ui": "link:../packages/ui",
    "@lexical/react": "^0.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.19.0",
    "lexical": "^0.52.0",
    "lucide-react": "^1.33.0",
    "mermaid": "^12.1.0",
    "plotly.js-strict-dist-min": "^4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@10.26.0"
}
