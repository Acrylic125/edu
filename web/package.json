{
  "name": "edu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-next.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:production-ben": "NEXT_PUBLIC_API_URL=https://edu-api.benapps.dev NEXT_PUBLIC_BACKEND_URL=https://edu.benapps.dev opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production-ben",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e:dev": "node scripts/run-e2e.mjs -- --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@edu/chat-contract": "link:../packages/chat-contract",
    "@legendapp/list": "^3.3.5",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.22",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.2",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-use-websocket": "^4.13.0",
    "recharts": "3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@10.26.0"
}
