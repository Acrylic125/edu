---
import { Image } from "astro:assets";
import codex from "../../../../desktop/src/renderer/assets/providers/codex.svg";
import antigravity from "../../../../desktop/src/renderer/assets/providers/antigravity.png";
import claude from "../../../../desktop/src/renderer/assets/providers/claude.svg";
import { links } from "../../links";
import "./download.css";

const integrations = [
  { name: "Codex", icon: codex },
  { name: "Antigravity", icon: antigravity },
  { name: "Claude Code", icon: claude },
];
const DownloadTag = links.download ? "a" : "button";
---

<download-section id="download" aria-labelledby="download-heading">
  <section class="download-stage">
    <div class="download-halo" aria-hidden="true"></div>
    <svg class="download-orbits" data-download-orbits fill="none" aria-hidden="true">
      <defs>
        {integrations.map((_, index) => (
          <linearGradient id={`download-trail-${index}`} gradientUnits="userSpaceOnUse">
            <stop stop-color="#b99541" stop-opacity="0" />
            <stop offset="0.55" stop-color="#e9c76c" stop-opacity="0.45" />
            <stop offset="1" stop-color="#f6e7af" />
          </linearGradient>
        ))}
      </defs>
      {integrations.map((_, index) => (
        <g data-download-orbit>
          <path class="download-trail-glow" stroke={`url(#download-trail-${index})`} />
          <path class="download-trail" data-download-path stroke={`url(#download-trail-${index})`} />
        </g>
      ))}
    </svg>

    <div class="download-copy">
      <h2 id="download-heading">Use your existing<br />subscriptions<span class="sr-only"> for free.</span></h2>
      <div class="download-reveal">
        <p class="download-free" aria-hidden="true">for free.</p>
        <DownloadTag class="action action-primary download-button" href={links.download || undefined} download={!!links.download} disabled={!links.download} title={!links.download ? "Download link coming soon" : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" />
          </svg>
          Download EdU
        </DownloadTag>
      </div>
    </div>

    {integrations.map((integration, index) => (
      <div class="download-integration" data-download-icon data-integration={index} style={`--icon-index: ${index}`}>
        <div class="download-icon-face">
          <Image src={integration.icon} width={64} height={64} alt="" class:list={{ "download-codex": index === 0 }} />
        </div>
        <span>{integration.name}</span>
      </div>
    ))}
  </section>
</download-section>

<script>
  import "./download";
</script>
