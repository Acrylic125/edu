---
import { Image } from "astro:assets";
import appIcon from "../../../../desktop/src/renderer/assets/app-icon.png";
import DownloadAction from "../download/DownloadAction.astro";
import BasisTransformation from "./BasisTransformation.astro";
import lecturePreview from "./assets/lecture-preview.png";
import "./transformation.css";

interface Props {
  socialPreview?: boolean;
}

const { socialPreview = false } = Astro.props;

const headlineWords = [
  { character: "看", word: "Now" },
  { character: "不", word: "I" },
  { character: "懂", word: "Understand." },
];
---

<transformation-hero data-view="understood" data-social-preview={socialPreview || undefined} aria-labelledby="intro">
  <div class="hero-viewport">
  <div class="hero-backdrop-frame" aria-hidden="true">
    <Image class="hero-lecture-backdrop" src={lecturePreview} alt="" widths={[800, 1200, 2000]} sizes="100vw" loading="eager" />
  </div>
  <header class="hero-brand">
    <Image src={appIcon} width={44} height={44} alt="" format="webp" />
    <span>EdU</span>
    <a class="hero-github action" href="https://github.com/Acrylic125/edu" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.32-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.1c0 .3.21.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
      GitHub
    </a>
  </header>
  <section class="transformation-stage">
    <div class="transformation-copy">
      {socialPreview && <h1 id="intro" class="hero-headline">Reframed to<br />understanding.</h1>}
      {!socialPreview && <h1 id="intro" class="hero-headline" aria-label="From 看不懂 to Now I Understand. EdU, your personal AI tutor.">
        {headlineWords.map(({ character, word }, index) => (
          <span class="hero-word" data-word={index} style={`--word-progress: var(--hero-word-${index}, 1)`} aria-hidden="true">
            <span class="hero-word-before" lang="zh-Hans">{character}</span>
            <span class="hero-word-after">{word}</span>
          </span>
        ))}
        <span class="hero-question" aria-hidden="true">。</span>
      </h1>}
      <div class="hero-description">
        <p class="hero-before">I dont understand</p>
        <p class="hero-after">Reframed to understanding</p>
      </div>
      <div class="hero-actions">
        <DownloadAction />
      </div>
    </div>

    <div class="transformation-example">
      <div class="transformation-art">
        <div class="transformation-canvas">
        <div class="understanding-paper" data-explanation aria-hidden="false">
          <BasisTransformation still={socialPreview} />
        </div>
        </div>
      </div>

    </div>
  </section>
  </div>
</transformation-hero>

<script>
  import "./transformation";
</script>
