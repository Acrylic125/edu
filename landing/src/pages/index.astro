---
import { Image, getImage } from "astro:assets";
import appIcon from "../../../desktop/src/renderer/assets/app-icon.png";
import { links } from "../links";
import "../styles.css";

const actions = [
  { label: "Download", href: links.download, primary: true },
  { label: "Use Skill", href: links.skill, primary: false },
];
const topics = ["Calculus", "Automata", "Exam revision"];
const favicon = await getImage({ src: appIcon, width: 64, height: 64, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="EdU is your personal AI tutor. Learn from your slides, practise what you know, and keep revision notes as you go." />
    <meta name="theme-color" content="#f4f4f1" />
    <meta property="og:title" content="EdU — Your personal AI tutor" />
    <meta property="og:description" content="Turn your slides, notes, and questions into lessons, practice, and revision notes." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>EdU — Your personal AI tutor</title>
    <script is:inline>
      const appearance = window.matchMedia("(prefers-color-scheme: dark)");
      function updateAppearance() {
        document.documentElement.classList.toggle("dark", appearance.matches);
        document.querySelector('meta[name="theme-color"]').content = appearance.matches ? "#1a1a19" : "#f4f4f1";
      }
      updateAppearance();
      appearance.addEventListener("change", updateAppearance);
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div class="mx-auto max-w-6xl px-6 sm:px-10">
      <header class="flex h-24 items-center gap-3 sm:h-28">
        <Image src={appIcon} width={44} height={44} alt="" format="webp" />
        <span class="text-xl font-semibold tracking-tight">EdU</span>
      </header>

      <main class="pb-10 sm:pb-14">
        <section aria-labelledby="intro" class="mx-auto mb-12 flex max-w-4xl items-center justify-between gap-8 pt-6 sm:mb-16 sm:pt-10">
          <div class="max-w-xl">
            <h1 id="intro" class="text-[2.75rem] font-semibold leading-[1.06] tracking-[-0.045em] sm:text-6xl lg:text-[4.25rem]">
              Your personal<br />AI tutor.
            </h1>
            <p class="mt-5 max-w-md text-base leading-7 text-muted-foreground">
              Turn your slides, notes, and questions into lessons, practice, and revision notes.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              {actions.map((action) => {
                let Tag: "a" | "button" = "button";
                if (action.href) Tag = "a";

                return (
                  <Tag
                    class:list={["action", { "action-primary": action.primary }]}
                    href={action.href || undefined}
                    download={action.primary && !!action.href}
                    disabled={!action.href}
                    title={!action.href ? `${action.label} link coming soon` : undefined}
                  >
                    {action.primary ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 6 5 6-5 6m9 0h5" />
                      </svg>
                    )}
                    {action.label}
                  </Tag>
                );
              })}
            </div>
          </div>
          <Image src={appIcon} width={320} height={320} alt="" format="webp" loading="eager" class="hidden w-[32%] max-w-80 shrink-0 sm:block" />
        </section>

        <section aria-label="Preview of EdU’s learning workspace with topics, study notes, and a tutor chat" role="img" class="overflow-hidden rounded-3xl border border-border bg-background shadow-sm">
          <div aria-hidden="true">
            <div class="flex h-12 items-center gap-3 border-b border-border px-5 text-xs sm:h-14">
              <span class="font-semibold">EdU</span>
              <span class="text-border">/</span>
              <span class="text-muted-foreground">Calculus</span>
            </div>
            <div class="grid sm:grid-cols-[160px_1fr] lg:grid-cols-[180px_1fr_300px]">
              <aside class="hidden border-r border-border bg-sidebar px-4 py-6 sm:block">
                <div class="mb-7 flex h-10 items-center justify-center gap-2 rounded-full bg-learning-yellow text-xs font-semibold text-learning-ink">
                  <span class="text-base">+</span> New topic
                </div>
                <p class="mb-3 px-3 text-[11px] text-muted-foreground">Your topics</p>
                <div class="space-y-1">
                  {topics.map((topic, index) => (
                    <div class:list={["rounded-xl px-3 py-2.5 text-xs", { "bg-sidebar-accent font-medium text-sidebar-accent-foreground": index === 0, "text-muted-foreground": index !== 0 }]}>{topic}</div>
                  ))}
                </div>
              </aside>

              <article class="m-3 rounded-[1.25rem] bg-card p-6 sm:m-4 sm:p-8 lg:p-10">
                <div class="mb-5 flex flex-wrap gap-2 text-[11px] text-muted-foreground">
                  <span class="rounded-md border border-border px-2 py-1">Lecture 03.pdf</span>
                  <span class="rounded-md border border-border px-2 py-1">Tutorial 03.pdf</span>
                </div>
                <h2 class="text-2xl font-semibold tracking-tight sm:text-[1.75rem]">Understanding derivatives</h2>
                <p class="mt-4 max-w-md text-sm leading-6 text-muted-foreground">A derivative tells you how fast something changes at a particular point.</p>
                <div class="my-6 rounded-2xl bg-learning-yellow px-5 py-4 text-learning-ink">
                  <p class="text-xs font-medium">For f(x) = x²</p>
                  <p class="mt-1 font-serif text-2xl">f′(x) = 2x</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs text-learning-ink">
                  <span class="rounded-full bg-learning-sage px-3 py-1.5">Limits</span>
                  <span class="rounded-full bg-learning-blue px-3 py-1.5">Rates of change</span>
                </div>
              </article>

              <aside class="mx-3 mb-3 flex flex-col rounded-[1.25rem] bg-card p-5 sm:mx-4 sm:mb-4 lg:ml-0 lg:mt-4">
                <p class="mb-5 text-xs font-semibold">Tutor chat</p>
                <p class="self-end rounded-2xl bg-muted px-4 py-3 text-xs leading-5">I get the formula. What does it mean?</p>
                <div class="py-5 text-xs leading-6">
                  <p>Think of the slope of a curve. At x = 3, the slope is 6: a small step along x gives roughly six times that change in y.</p>
                  <p class="mt-3 font-medium">Why does the slope get steeper as x gets larger?</p>
                </div>
                <div class="mt-auto rounded-2xl border border-border p-3 text-xs text-muted-foreground">Message your tutor…</div>
              </aside>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
