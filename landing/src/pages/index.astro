---
import { Image, getImage } from "astro:assets";
import appIcon from "../../../desktop/src/renderer/assets/app-icon.png";
import LearningDemo from "../components/demo/LearningDemo.astro";
import DownloadSection from "../components/download/DownloadSection.astro";
import HeroArtwork from "../components/hero/HeroArtwork.astro";
import { links } from "../links";
import "../styles.css";

const actions = [
  { label: "Download", href: links.download, primary: true },
  { label: "Use Skill", href: links.skill, primary: false },
];
const favicon = await getImage({ src: appIcon, width: 64, height: 64, format: "png" });
const title = "EdU — Your personal AI tutor";
const description = "EdU is your personal AI tutor. Learn from your slides, practise what you know, and keep revision notes as you go.";
const imageAlt = "EdU — Your personal AI tutor, with a stack of blue, green, and yellow books.";
const canonicalUrl = new URL("/", Astro.site);
const imageUrl = new URL("/social-preview.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f4f1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="EdU" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title}</title>
    <script is:inline>
      const appearance = window.matchMedia("(prefers-color-scheme: dark)");
      function updateAppearance() {
        document.documentElement.classList.toggle("dark", appearance.matches);
        document.querySelector('meta[name="theme-color"]').content = appearance.matches ? "#1a1a19" : "#f4f4f1";
      }
      updateAppearance();
      appearance.addEventListener("change", updateAppearance);
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div class="mx-auto max-w-6xl px-6 sm:px-10">
      <header class="flex h-20 items-center gap-3 sm:h-28">
        <Image src={appIcon} width={44} height={44} alt="" format="webp" />
        <span class="text-xl font-semibold tracking-tight">EdU</span>
      </header>

      <main>
        <section aria-labelledby="intro" class="mb-12 flex flex-col items-center justify-between gap-6 pt-3 sm:mb-16 sm:flex-row sm:gap-8 sm:pt-10">
          <div class="w-full min-w-0 max-w-xl sm:w-auto sm:flex-1">
            <h1 id="intro" class="text-[clamp(3.4rem,15vw,5.5rem)] font-semibold leading-[0.98] tracking-[-0.065em] sm:text-6xl sm:leading-[1.06] sm:tracking-[-0.045em] lg:text-[4.25rem]">
              Your personal<br />AI tutor.
            </h1>
            <p class="mt-3 max-w-md text-base leading-7 text-muted-foreground sm:mt-5">
              Turn your slides, notes, and questions into lessons, practice, and revision notes.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 sm:mt-7">
              {actions.map((action) => {
                let Tag: "a" | "button" = "button";
                if (action.href) Tag = "a";

                return (
                  <Tag
                    class:list={["action", { "action-primary": action.primary }]}
                    href={action.href || undefined}
                    download={action.primary && !!action.href}
                    disabled={!action.href}
                    title={!action.href ? `${action.label} link coming soon` : undefined}
                  >
                    {action.primary ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 6 5 6-5 6m9 0h5" />
                      </svg>
                    )}
                    {action.label}
                  </Tag>
                );
              })}
            </div>
          </div>
          <HeroArtwork />
        </section>

        <LearningDemo />
        <DownloadSection />
      </main>
    </div>
  </body>
</html>
