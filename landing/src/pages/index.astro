---
import { Image, getImage } from "astro:assets";
import appIcon from "../../../desktop/src/renderer/assets/app-icon.png";
import LearningDemo from "../components/demo/LearningDemo.astro";
import DownloadSection from "../components/download/DownloadSection.astro";
import TransformationHero from "../components/hero/TransformationHero.astro";
import "../styles.css";

const favicon = await getImage({ src: appIcon, width: 64, height: 64, format: "png" });
const title = "EdU — Your personal AI tutor";
const description = "EdU is your personal AI tutor. Learn from your slides, practise what you know, and keep revision notes as you go.";
const imageAlt = "EdU — Your personal AI tutor, with a stack of blue, green, and yellow books.";
const canonicalUrl = new URL("/", Astro.site);
const imageUrl = new URL("/social-preview.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f4f1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="EdU" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title}</title>
    <script is:inline>
      const appearance = window.matchMedia("(prefers-color-scheme: dark)");
      function updateAppearance() {
        document.documentElement.classList.toggle("dark", appearance.matches);
        document.querySelector('meta[name="theme-color"]').content = appearance.matches ? "#1a1a19" : "#f4f4f1";
      }
      updateAppearance();
      appearance.addEventListener("change", updateAppearance);
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div class="mx-auto max-w-6xl px-6 sm:px-10">
      <header class="flex h-20 items-center gap-3 sm:h-28">
        <Image src={appIcon} width={44} height={44} alt="" format="webp" />
        <span class="text-xl font-semibold tracking-tight">EdU</span>
      </header>

      <main>
        <TransformationHero />

        <LearningDemo />
        <DownloadSection />
      </main>
    </div>
  </body>
</html>
